# Python bytecode
__pycache__/
*.pyc

# Virtualenvs (uv writes .venv/ in the repo root)
.venv/
venv/

# Build / packaging output
build/
dist/
*.egg-info/

# Test and tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Generated reports. Every documented entrypoint writes here by default
# (`scripts/benchmark.py`, `run_smoke_benchmark.py`, `import_goz_experiment.py`,
# `compare_runs.py`), so without this a quickstart run leaves the tree dirty and
# run artifacts get committed by accident. The .gitkeep placeholders stay tracked.
/reports/**
!/reports/**/
!/reports/**/.gitkeep
